{
  "name": "cachyos-nvme-limine-dual-gpu",
  "description": "CachyOS on an NVMe SSD (Limine + limine-mkinitcpio, pacman). NVIDIA RTX primary plus an AMD GCN R7 250 driving a VGA CRT; the VGA output is the connected one.",
  "os_release": "NAME=\"CachyOS Linux\"\nID=cachyos\nID_LIKE=arch\n",
  "uname_r": "7.3.1-2-cachyos",
  "which": ["pacman", "makepkg", "limine-mkinitcpio", "mkinitcpio", "git", "sudo"],
  "exists": ["/etc/default/limine", "/etc/mkinitcpio.conf"],
  "lspci": "0000:01:00.0 VGA compatible controller [0300]: NVIDIA Corporation GA104 [GeForce RTX 3070] [10de:2484] (rev a1)\n0000:03:00.0 VGA compatible controller [0300]: Advanced Micro Devices, Inc. [AMD/ATI] Oland [Radeon R7 250] [1002:6610]\n0000:00:14.0 USB controller [0c03]: Intel Corporation USB 3.0 xHCI [8086:a12f]\n",
  "connectors": [
    {"card": "card0", "name": "DP-1", "status": "disconnected"},
    {"card": "card1", "name": "VGA-1", "status": "connected"},
    {"card": "card1", "name": "HDMI-A-1", "status": "disconnected"}
  ],
  "files": {
    "etc/default/limine": "TIMEOUT=5\nKERNEL_CMDLINE[default]=\"quiet splash\"\nENABLE_UKI=yes\n",
    "etc/mkinitcpio.conf": "MODULES=(amdgpu nvidia)\nFILES=()\nHOOKS=(base udev autodetect modconf kms block filesystems)\n"
  },
  "lsblk": {
    "blockdevices": [
      {
        "name": "nvme0n1", "path": "/dev/nvme0n1", "id-link": "nvme-Samsung_SSD_980_PRO_1TB_S5GXNX0T123456A",
        "model": "Samsung SSD 980 PRO 1TB", "serial": "S5GXNX0T123456A", "size": "931.5G", "tran": "nvme",
        "mountpoints": [], "uuid": null, "partuuid": null, "fstype": null, "rm": false, "type": "disk",
        "children": [
          {"name": "nvme0n1p1", "path": "/dev/nvme0n1p1", "size": "1G", "mountpoints": ["/boot"],
           "uuid": "AAAA-0001", "partuuid": "22222222-aaaa-4bbb-8ccc-000000000001", "fstype": "vfat", "rm": false, "type": "part"},
          {"name": "nvme0n1p2", "path": "/dev/nvme0n1p2", "size": "930G", "mountpoints": ["/"],
           "uuid": "5f0e1c1a-0000-4000-8000-00000000bbb1", "partuuid": "22222222-aaaa-4bbb-8ccc-000000000002", "fstype": "btrfs", "rm": false, "type": "part"}
        ]
      }
    ]
  },
  "expected": {
    "package_manager": "pacman",
    "can_build_kernel": true,
    "gpu_profile": "dual-nvidia-amd",
    "initramfs_command": ["limine-mkinitcpio"],
    "bootloaders": ["limine"],
    "connector": "VGA-1",
    "edid_file": "crufile.bin",
    "adapter": "analog-native",
    "kernel_target": {"kver": "7.3", "subdir": "linux-cachyos", "commit": "origin/master", "patch_series": "linux-7.3"},
    "udev_rule_links": ["primary-nvidia", "secondary-amd"],
    "environment_files": ["amd-dual-gpu.conf-absent", "nvidia-prime.conf", "kwin-cursor.conf"],
    "limine_cmdline_contains": ["drm.edid_firmware=VGA-1:edid/crufile.bin", "video=VGA-1:e", "quiet splash"],
    "mkinitcpio_files_contains": "/usr/lib/firmware/edid/crufile.bin"
  }
