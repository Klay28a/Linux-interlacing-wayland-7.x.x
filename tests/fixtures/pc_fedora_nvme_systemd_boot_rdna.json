{
  "name": "fedora-nvme-systemd-boot-rdna",
  "description": "Fedora 41 on an NVMe SSD (systemd-boot, dracut, dnf). A single RDNA 3 card feeds a CRT through a DisplayPort-to-VGA DAC, so DP-1 is the connected output. Not Arch: only --config-only can run here.",
  "os_release": "NAME=\"Fedora Linux\"\nID=fedora\nVERSION_ID=41\n",
  "uname_r": "6.12.9-200.fc41.x86_64",
  "which": ["dnf", "bootctl", "dracut", "git", "sudo"],
  "exists": ["/etc/kernel/cmdline", "/etc/dracut.conf.d", "/boot/loader/entries"],
  "lspci": "0000:03:00.0 VGA compatible controller [0300]: Advanced Micro Devices, Inc. [AMD/ATI] Navi 32 [Radeon RX 7800 XT] [1002:747e] (rev c8)\n0000:03:00.1 Audio device [0403]: Advanced Micro Devices, Inc. [AMD/ATI] Navi 31 HDMI/DP Audio [1002:ab30]\n",
  "connectors": [
    {"card": "card0", "name": "DP-1", "status": "connected"},
    {"card": "card0", "name": "DP-2", "status": "disconnected"},
    {"card": "card0", "name": "HDMI-A-1", "status": "disconnected"}
  ],
  "files": {
    "etc/kernel/cmdline": "root=UUID=5f0e1c1a-0000-4000-8000-00000000ccc1 rootflags=subvol=root rhgb quiet\n",
    "boot/loader/entries/fedora-6.12.9.conf": "title Fedora Linux (6.12.9-200.fc41.x86_64)\nlinux /vmlinuz-6.12.9-200.fc41.x86_64\ninitrd /initramfs-6.12.9-200.fc41.x86_64.img\noptions root=UUID=5f0e1c1a-0000-4000-8000-00000000ccc1 rootflags=subvol=root rhgb quiet\n"
  },
  "bootctl": {"--print-esp-path": "/boot/efi", "--print-boot-path": "/boot"},
  "lsblk": {
    "blockdevices": [
      {
        "name": "nvme0n1", "path": "/dev/nvme0n1", "id-link": "nvme-WD_BLACK_SN850X_2000GB_23123A800001",
        "model": "WD_BLACK SN850X 2000GB", "serial": "23123A800001", "size": "1.8T", "tran": "nvme",
        "mountpoints": [], "uuid": null, "partuuid": null, "fstype": null, "rm": false, "type": "disk",
        "children": [
          {"name": "nvme0n1p1", "path": "/dev/nvme0n1p1", "size": "600M", "mountpoints": ["/boot/efi"],
           "uuid": "BBBB-0002", "partuuid": "33333333-aaaa-4bbb-8ccc-000000000001", "fstype": "vfat", "rm": false, "type": "part"},
          {"name": "nvme0n1p2", "path": "/dev/nvme0n1p2", "size": "1G", "mountpoints": ["/boot"],
           "uuid": "5f0e1c1a-0000-4000-8000-00000000ccc2", "partuuid": "33333333-aaaa-4bbb-8ccc-000000000002", "fstype": "xfs", "rm": false, "type": "part"},
          {"name": "nvme0n1p3", "path": "/dev/nvme0n1p3", "size": "1.8T", "mountpoints": ["/"],
           "uuid": "5f0e1c1a-0000-4000-8000-00000000ccc1", "partuuid": "33333333-aaaa-4bbb-8ccc-000000000003", "fstype": "btrfs", "rm": false, "type": "part"}
        ]
      }
    ]
  },
  "expected": {
    "package_manager": "dnf",
    "can_build_kernel": false,
    "gpu_profile": "rdna-single",
    "initramfs_command": ["dracut", "--regenerate-all", "--force"],
    "bootloaders": ["systemd-boot"],
    "connector": "DP-1",
    "edid_file": "cru-dp-1.bin",
    "adapter": "dp-dac",
    "kernel_target": {"kver": "6.12", "subdir": "linux-cachyos-lts", "commit": "1a3b979f284e343eb56a73c45c0ad8d3bf11ecde", "patch_series": "linux-6.12"},
    "udev_rule_links": [],
    "environment_files": ["amd-dual-gpu.conf-absent", "nvidia-prime.conf-absent", "kwin-cursor.conf"],
    "kernel_cmdline_contains": ["drm.edid_firmware=DP-1:edid/cru-dp-1.bin", "video=DP-1:e", "rhgb quiet"],
    "dracut_conf_contains": "/usr/lib/firmware/edid/cru-dp-1.bin"
  }
}
